<%- include('partials/head',{title:'전시품 수정'}) %><section class="content form-wrap"><h1>전시품 수정</h1><form class="form" method="post" action="/items/<%= item.id %>/edit"><label>이름<input name="title" value="<%= item.title %>" required></label><label>시대<select name="era"><% eras.forEach(e=>{ %><option value="<%= e.id %>" <%= e.id===item.era_id?'selected':'' %>><%= e.label %></option><% }) %></select></label><label>설명<textarea name="description" rows="8" required><%= item.description %></textarea></label><label>등록 비밀번호<input type="password" name="password" required></label><button class="btn primary">수정 저장</button></form></section><%- include('partials/foot') %>