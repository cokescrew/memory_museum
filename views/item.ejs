<%- include('partials/head',{title:item.title}) %><section class="content detail"><a class="text-link" href="<%= item.type==='official'?'/archive/'+item.era_id:'/citizen' %>">← 전시관으로</a><div class="detail-layout"><div class="detail-photo"><img src="<%= item.image_path || eras.find(e=>e.id===item.era_id).image %>" alt="<%= item.title %>"></div><div><div class="eyebrow"><%= item.type==='official'?'공식 전시품':'시민 전시품' %> · <%= item.era_label %></div><h1><%= item.title %></h1><% if(item.type==='official' && item.description.split('\n\n').length===3){ const parts=item.description.split('\n\n'); %><div class="museum-category"><%= parts[0] %></div><h2 class="museum-subheading">물건 소개</h2><p class="description"><%= parts[1] %></p><h2 class="museum-subheading">시대 속 이야기</h2><p class="description"><%= parts[2] %></p><small>사진: 제공 자료 · 원출처 미확인</small><% } else { %><p class="description"><%= item.description %></p><% } %><% if(item.type==='citizen'){ %><a class="text-link" href="/items/<%= item.id %>/edit">수정하기</a><form method="post" action="/items/<%= item.id %>/delete" class="inline-form" onsubmit="return confirm('정말 삭제할까요?')"><input type="password" name="password" placeholder="등록 비밀번호" required><button class="small-btn">전시품 삭제</button></form><form method="post" action="/report" class="inline-form"><input type="hidden" name="type" value="item"><input type="hidden" name="id" value="<%= item.id %>"><select name="reason"><option>광고</option><option>욕설</option><option>부적절한 내용</option><option>허위 정보</option><option>기타</option></select><button class="small-btn">신고</button></form><% } %></div></div><section class="comments"><h2>남겨진 이야기 <span><%= comments.length %></span></h2><% if(typeof msg!=='undefined'&&msg){ %><p class="notice"><%= msg %></p><% } %><form class="form comment-form" method="post" action="/items/<%= item.id %>/comments"><label>익명 댓글<textarea name="body" rows="3" maxlength="1000" required placeholder="이 물건에 얽힌 이야기를 남겨주세요."></textarea></label><label>삭제용 비밀번호<input name="password" type="password" minlength="4" required></label><button class="btn primary">댓글 남기기</button></form><% comments.forEach(c=>{ %><article class="comment"><% if(admin){ %><form method="post" action="/admin/delete/comment/<%= c.id %>"><button class="small-btn">관리자 삭제</button></form><% } %><small>익명 · <%= new Date(c.created_at).toLocaleDateString('ko-KR') %></small><p><%= c.body %></p><div class="comment-actions"><form action="/comments/<%= c.id %>/delete" method="post" class="inline-form"><input type="password" name="password" placeholder="비밀번호" required><button class="small-btn">삭제</button></form><form action="/report" method="post" class="inline-form"><input type="hidden" name="type" value="comment"><input type="hidden" name="id" value="<%= c.id %>"><input type="hidden" name="item_id" value="<%= item.id %>"><select name="reason"><option>광고</option><option>욕설</option><option>부적절한 내용</option><option>허위 정보</option><option>기타</option></select><button class="small-btn">신고</button></form></div></article><% }) %></section></section><%- include('partials/foot') %>