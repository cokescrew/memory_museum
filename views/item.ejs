<%- include('partials/head', {title: item.title}) %>

<section class="content detail">

    <div class="detail-topbar">

        <a class="text-link"
           href="<%= item.type === 'official' ? '/archive/' + item.era_id : '/citizen' %>">
            ← 전시관으로
        </a>

        <div class="mini-actions">

            <% if (item.type === 'citizen') { %>

                <button type="button"
                    data-edit-url="/items/<%= item.id %>/edit"
                    data-edit-kind="item">
                    수정
                </button>

                <button type="button"
                    data-delete-url="/items/<%= item.id %>/delete">
                    삭제
                </button>

                <button type="button"
                    data-report-type="item"
                    data-report-id="<%= item.id %>">
                    신고
                </button>

            <% } %>

            <% if (admin) { %>

                <form method="post"
                    action="/admin/delete/item/<%= item.id %>"
                    onsubmit="return confirm('관리자 권한으로 삭제할까요?')">

                    <button type="submit">
                        관리자 삭제
                    </button>

                </form>

            <% } %>

        </div>

    </div>

    <div class="detail-layout">

        <div class="detail-photo">

            <img
                src="<%= item.image_path || eras.find(e => e.id === item.era_id).image %>"
                alt="<%= item.title %>">

        </div>

        <div>

            <div class="eyebrow">
                <%= item.type === 'official' ? '공식 전시품' : '시민 전시품' %>
                · <%= item.era_label %>
            </div>

            <h1><%= item.title %></h1>

            <p class="description"><%= item.description %></p>

        </div>

    </div>

    <% if (typeof msg !== 'undefined' && msg) { %>
        <p class="notice"><%= msg %></p>
    <% } %>

    <%- include('partials/compact-comments', {
        comments: comments,
        parentId: item.id,
        board: 'item',
        heading: '남겨진 이야기',
        placeholder: '이 물건에 얽힌 이야기를 남겨주세요.'
    }) %>

</section>

<script src="/js/post-actions.js"></script>

<%- include('partials/foot') %>