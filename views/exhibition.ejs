<%- include('partials/head', { title: era.label }) %>

<%
/* =========================================
   시대별 전시실 정보
========================================= */

const roomInfo = {
    1960: {
        number: 1,
        subtitle: '소박했던 일상',
        image: '/images/gallery-1960.png'
    },
    1970: {
        number: 2,
        subtitle: '변화하는 생활',
        image: '/images/gallery-1970.png'
    },
    1980: {
        number: 3,
        subtitle: '문화와 여가의 시대',
        image: '/images/gallery-1980.png'
    },
    1990: {
        number: 4,
        subtitle: '아날로그와 디지털의 공존',
        image: '/images/gallery-1990.png'
    },
    2000: {
        number: 5,
        subtitle: '새로운 시대의 시작',
        image: '/images/gallery-2000.png'
    }
};

// 현재 관람 중인 시대
const year = Number(era.id);

// 전체 전시실 관람 순서
const years = [1960, 1970, 1980, 1990, 2000];

// 현재 전시실 정보
const room = roomInfo[year];

// 현재 전시실 위치
const index = years.indexOf(year);
%>

<section class="museum-gallery">

    <!-- 전시실 상단 -->
    <div class="museum-gallery-header">

        <span>추억 박물관</span>

        <a href="/archive">
            ▧ 관람 안내도
        </a>

    </div>


    <!-- 시대별 전시실 사진 -->
    <div class="museum-gallery-photo">

        <img
            src="<%= room.image %>"
            alt="<%= year %>년대 전시실"
        >

    </div>


    <!-- 전시실 하단 콘텐츠 -->
    <div class="museum-gallery-content">

        <!-- 현재 관람 위치 -->
        <p class="museum-room-number">

            제<%= room.number %>전시실
            ·
            <%= room.number %> / <%= years.length %>

        </p>


        <!-- 전시실 제목 -->
        <h1 class="museum-room-title">

            <%= year %>년대 — <%= room.subtitle %>

        </h1>


        <!-- DB에 등록된 전시품 버튼 -->
        <div class="museum-exhibit-buttons">

            <% items.forEach(item => { %>

                <a
                    href="/items/<%= item.id %>"
                    class="museum-exhibit-button"
                >

                    <%= item.title %>

                </a>

            <% }); %>

        </div>


        <!-- 이전 및 다음 전시실 이동 -->
        <div class="museum-gallery-navigation">

            <!-- 이전 전시실 -->
            <% if (index === 0) { %>

                <a href="/archive">
                    〈 박물관 입구
                </a>

            <% } else { %>

                <a href="/archive/<%= years[index - 1] %>">

                    〈 <%= years[index - 1] %>년대 전시실

                </a>

            <% } %>


            <!-- 다음 전시실 -->
            <% if (index < years.length - 1) { %>

                <a href="/archive/<%= years[index + 1] %>">

                    <%= years[index + 1] %>년대 전시실 〉

                </a>

            <% } else { %>

                <a href="/citizen">
                    모두의 추억 〉
                </a>

            <% } %>

        </div>

    </div>

</section>

<%- include('partials/foot') %>