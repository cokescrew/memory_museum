<%- include('partials/head',{title:title}) %>
<% const themes={1960:['소박했던 일상의 기억','우리 곁을 지켰던 생활용품을 만나봅니다.'],1970:['변화하는 가정의 풍경','새로운 물건들이 가정의 일상을 바꾸기 시작했습니다.'],1980:['즐거움이 늘어난 일상','여가와 기록의 문화가 자리 잡던 시절입니다.'],1990:['디지털 시대의 시작','새로운 통신기기가 사람과 세상을 연결했습니다.'],2000:['손안으로 들어온 세상','통신과 학습, 음악이 일상 속으로 들어왔습니다.']}; %>
<section class="content museum-exhibition"><a class="text-link" href="/archive">← 추억 저장소</a><div class="museum-heading"><div class="eyebrow">PERMANENT COLLECTION · <%= era.id %></div><h1><%= themes[era.id][0] %></h1><p><%= era.label %> · <%= themes[era.id][1] %></p></div><div class="museum-grid"><% items.forEach((item,i)=>{ %><a class="museum-object" href="/items/<%= item.id %>"><figure><img src="<%= item.image_path || era.image %>" alt="<%= item.title %>"></figure><div class="museum-label"><small>EXHIBIT <%= String(i+1).padStart(2,'0') %></small><h2><%= item.title %></h2><p><%= item.description.split('\n\n')[1] || item.description %></p><span>전시품 자세히 보기 →</span></div></a><% }) %></div><% if(!items.length){ %><p>아직 등록된 전시품이 없습니다.</p><% } %></section><%- include('partials/foot') %>