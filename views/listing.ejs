<%- include('partials/head',{title:title}) %><section class="content wide"><div class="eyebrow"><%= section==='citizen'?'CITIZEN EXHIBITION':'OFFICIAL COLLECTION' %></div><h1><%= title %></h1><p><%= intro %></p><% if(section==='citizen'){ %><div class="toolbar"><form action="/citizen" method="get"><input name="q" value="<%= typeof q!=='undefined'?q:'' %>" placeholder="물건 이름이나 설명 검색"><select name="era"><option value="">모든 시대</option><% eras.forEach(e=>{ %><option value="<%= e.id %>" <%= selectedEra===e.id?'selected':'' %>><%= e.label %></option><% }) %></select><button class="btn" type="submit">검색</button></form><a class="btn primary" href="/citizen/new">+ 물건 등록</a></div><% } %><% if(typeof msg!=='undefined'&&msg){ %><p class="notice"><%= msg %></p><% } %><div class="item-grid"><% items.forEach(item=>{ %><a class="item-card" href="/items/<%= item.id %>"><img src="<%= item.image_path || eras.find(e=>e.id===item.era_id).image %>" alt=""><div><small><%= eras.find(e=>e.id===item.era_id).label %></small><h3><%= item.title %></h3><p><%= item.description.slice(0,75) %></p></div></a><% }) %></div><% if(!items.length){ %><div class="empty">아직 전시된 물건이 없습니다.<br>시민 전시관에서는 첫 번째 물건을 등록해 볼 수 있어요.</div><% } %><a class="text-link" href="/archive">← 시대별 전시관으로</a></section><%- include('partials/foot') %>