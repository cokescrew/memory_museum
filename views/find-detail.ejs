<%- include('partials/head',{title:'추억 찾기'}) %><section class="content"><h1><%= post.title %></h1><p class="description"><%= post.description %></p><a href="/find" class="btn">목록</a><details><summary>글 수정 / 삭제</summary><form class="form" method="post" action="/find/<%= post.id %>/edit"><input name="title" value="<%= post.title %>" required><textarea name="description" required><%= post.description %></textarea><input type="password" name="password" placeholder="비밀번호" required><button class="btn">수정</button><button class="btn" formaction="/find/<%= post.id %>/delete">삭제</button></form></details><h2>댓글</h2><form class="form" method="post" action="/find/<%= post.id %>/comments"><textarea name="body" required></textarea><input type="password" name="password" minlength="4" placeholder="비밀번호" required><button class="btn">댓글 등록</button></form><% comments.forEach(c=>{ %><article class="comment"><small>익명</small><p><%= c.body %></p><form class="inline-form" method="post" action="/find/comments/<%= c.id %>/delete"><input type="password" name="password" placeholder="비밀번호" required><button class="small-btn">삭제</button></form><% if(admin){ %><form method="post" action="/admin/delete/wantedComment/<%= c.id %>"><button class="small-btn">관리자 삭제</button></form><% } %></article><% }) %></section><%- include('partials/foot') %>