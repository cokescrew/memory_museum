<%- include('partials/head', {title: post.title}) %>

<section class="content detail find-board">

    <div class="detail-topbar">

        <a class="text-link" href="/find">
            ← 추억 찾기로
        </a>

        <div class="mini-actions">

            <button type="button"
                data-edit-url="/find/<%= post.id %>/edit"
                data-edit-kind="wanted">
                수정
            </button>

            <button type="button"
                data-delete-url="/find/<%= post.id %>/delete">
                삭제
            </button>

            <% if (admin) { %>

                <form method="post"
                    action="/admin/delete/wanted/<%= post.id %>"
                    onsubmit="return confirm('게시글을 삭제할까요?')">

                    <button type="submit">
                        관리자 삭제
                    </button>

                </form>

            <% } %>

        </div>

    </div>

    <h1><%= post.title %></h1>

    <p class="description"><%= post.description %></p>

    <%- include('partials/compact-comments', {
        comments: comments,
        parentId: post.id,
        board: 'find',
        heading: '물건에 대한 제보',
        placeholder: '이 물건에 대해 알고 있는 정보를 남겨주세요.'
    }) %>

</section>

<script src="/js/post-actions.js"></script>

<%- include('partials/foot') %>